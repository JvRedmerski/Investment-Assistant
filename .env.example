# ==========================================
# INVESTMENT ASSISTANT - ENVIRONMENT CONFIG
# ==========================================

# Application
APP_NAME="Investment Assistant"
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ALGORITHM=HS256
# 60 * 24 * 8 = 8 dias — mesmo default de app/core/config.py
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database (PostgreSQL)
POSTGRES_DB=investment_assistant
POSTGRES_USER=investment_user
POSTGRES_PASSWORD=investment_pass_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://investment_user:investment_pass_dev@postgres:5432/investment_assistant

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Market Data Integrations (Wave 05)
MARKET_DATA_PROVIDER=brapi
BRAPI_TOKEN=your_brapi_api_token_here
BRAPI_BASE_URL=https://brapi.dev/api
MARKET_DATA_TIMEOUT_SECONDS=10.0
MARKET_DATA_MAX_RETRIES=3
# Intervalo mínimo entre requisições ao provedor. O default do código é 0.0
# (sem espaçamento). A Brapi tem cota mensal no plano gratuito e aceita 1 ativo
# por requisição — defina um intervalo antes de qualquer ingestão em lote.
MARKET_DATA_MIN_REQUEST_INTERVAL_SECONDS=0.0
# Maior janela de histórico que o plano da Brapi entrega. O plano gratuito
# para em "3mo" e responde HTTP 400 INVALID_RANGE acima disso; como todo
# range é ancorado em hoje (a API não aceita data inicial), isto é um teto
# de quanto se alcança para trás, não um tamanho de página.
BRAPI_MAX_RANGE=3mo

# Fundamentals (Waves 06 e 09)
# "cvm_then_brapi" põe a CVM na frente e a Brapi atrás (ADR-020);
# "cvm" e "brapi" selecionam uma fonte única.
FUNDAMENTALS_PROVIDER=cvm_then_brapi
FUNDAMENTALS_TIMEOUT_SECONDS=15.0
FUNDAMENTALS_MAX_RETRIES=3
FUNDAMENTALS_MIN_REQUEST_INTERVAL_SECONDS=0.0

# Dados abertos da CVM — sem token, sem cota. Um ZIP (~13 MB) por exercício,
# cacheado em disco; um ano é baixado no máximo uma vez.
CVM_DFP_BASE_URL=https://dados.cvm.gov.br/dados/CIA_ABERTA/DOC/DFP/DADOS
CVM_CACHE_DIR=var/cvm
CVM_TIMEOUT_SECONDS=180.0
CVM_MAX_RETRIES=3
CVM_FIRST_YEAR=2020

# Benchmarks (Wave 08). CDI/Selic/IPCA vêm do SGS do Banco Central:
# aberto, sem token e sem cota, porém mais lento que a Brapi.
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie
BENCHMARK_TIMEOUT_SECONDS=30.0
BENCHMARK_MAX_RETRIES=3
BENCHMARK_MIN_REQUEST_INTERVAL_SECONDS=0.0

# --- AI Engine (Wave 12) -----------------------------------------------
# The model explains numbers the backend already computed and never
# produces one of its own (ADR-009), so nothing here can change a figure
# anywhere in the system: the worst a bad value does is leave the
# explanation unavailable.
#
# "gemini" is the hosted default and needs a key from Google AI Studio,
# with the Gemini API enabled for its Google Cloud project. "ollama"
# points at a local server, needs no key and sends nothing off the
# machine (AGENTS.md rules 42/91). "none" switches explanations off,
# which is the honest setting for a deployment with no credential.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# An alias, not a pinned build: the model that actually answered is
# recorded on every explanation.
GEMINI_MODEL=gemini-flash-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

AI_TIMEOUT_SECONDS=60.0
AI_MAX_RETRIES=3
AI_MIN_REQUEST_INTERVAL_SECONDS=0.0
# Low, not zero. Text feeds no calculation (rule 113 does not apply), but
# an explanation that rewords itself on every refresh reads as unreliable.
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1024

# --- Historical prices, B3 COTAHIST open series (PRICE-001) ------------
# The exchange's own end-of-day file: free, no token, no quota, and it
# reaches back decades where BRAPI_MAX_RANGE stops at ~63 sessions.
# One ZIP per calendar year covering every listed instrument (~79 MB for
# 2024); it is distilled to the spot market and cached, so a year is
# downloaded at most once. Prices are UNADJUSTED - see ADR-023.
HISTORICAL_PRICE_PROVIDER=b3_cotahist

# Which source serves intraday candles (1m/5m/15m). Its own setting rather
# than a reuse of MARKET_DATA_PROVIDER because the two are not the same
# question: a vendor can quote and serve daily bars without serving intraday
# at all.
# WARNING - measured on 2026-08-22: on Brapi's free plan intraday is granted
# PER TICKER, not per interval. PETR4, ITUB4, MGLU3 and VALE3 are served;
# BBAS3 and BOVA11 answer HTTP 400 INVALID_INTERVAL for the same interval
# that works for the others. The vendor's message blames the interval; the
# ticker is what differs. Surfaces as INTRADAY_NOT_AVAILABLE, and on that
# path an unknown ticker gives the same error rather than a 404.
INTRADAY_PROVIDER=brapi
B3_COTAHIST_BASE_URL=https://bvmf.bmfbovespa.com.br/InstDados/SerHist
B3_COTAHIST_CACHE_DIR=var/b3
# A whole-file download over a slow link, not an API call.
B3_COTAHIST_TIMEOUT_SECONDS=600.0
B3_COTAHIST_MAX_RETRIES=3
# Earliest calendar year to pull. Each year is another download and a few
# more megabytes on disk once distilled.
B3_COTAHIST_FIRST_YEAR=2015
